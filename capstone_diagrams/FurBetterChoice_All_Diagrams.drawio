        <mxCell id="f8_launch" value="App Launch" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D5B;strokeColor=#1B4D36;strokeWidth=3;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="340" y="30" width="180" height="45" as="geometry" />
        </mxCell>

