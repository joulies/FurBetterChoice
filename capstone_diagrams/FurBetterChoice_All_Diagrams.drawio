        <mxCell id="f8_auth_scr" value="AuthScreens&#xa;(Login / Sign Up / Verify Email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#2E7D5B;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="40" y="117" width="230" height="55" as="geometry" />
        </mxCell>

        <!-- Main Dashboard -->
        <mxCell id="f8_dash" value="MainDashboard &amp; FloatingBottomNav&#xa;(4 Bottom Tabs: Home | Profile | Community | Settings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#2E7D5B;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="210" y="225" width="440" height="55" as="geometry" />
        </mxCell>

        <!-- Group 1: Guest & Authenticated Accessible Tabs (Left Zone - Flat parent=1) -->
        <mxCell id="f8_grp_guest" value="Accessible to Both Guest &amp; Authenticated Users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F9F5;strokeColor=#2E7D5B;strokeWidth=2;verticalAlign=top;align=center;spacingTop=8;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1B4D36;" vertex="1" parent="1">
