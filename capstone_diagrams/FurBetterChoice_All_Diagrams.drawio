  <diagram id="figure_8_navigation_map" name="Figure 8: Hierarchical Navigation Map">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="900" math="0" shadow="0">
      <root>
