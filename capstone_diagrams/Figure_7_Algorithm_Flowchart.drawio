  <diagram id="figure_7_program_flowchart_nutrition_and_allergy" name="Figure 7: Program Flowchart (Nutrition &amp; Allergy)">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Start -->
        <mxCell id="f7_start" value="Start Product Evaluation" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2E7D5B;strokeColor=#1B4D36;strokeWidth=3;fontFamily=Arial;fontSize=13;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="310" y="40" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="f7_s1" value="Detect Pet Species (Dog / Cat) &amp; Life Stage&#xa;(Growth / Reproduction vs. Adult Maintenance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#2E7D5B;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="250" y="130" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- Decision 1: Moisture -->
        <mxCell id="f7_d1" value="Moisture %&#xa;Listed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D4A017;strokeWidth=2;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="335" y="230" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- Left Branch: DM Calc -->
        <mxCell id="f7_dm" value="Calculate Dry Matter (DM%)&#xa;DM% = 100 - Moisture%&#xa;Nutrient DM = (As-Fed / DM%) x 100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#2E7D5B;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- Right Branch: As-Fed Fallback -->
        <mxCell id="f7_raw" value="Flag Missing Moisture&#xa;Use As-Fed Values &amp; Show Note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D4A017;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="490" y="360" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- Step 2: Standards Check -->
        <mxCell id="f7_s2" value="Evaluate Against FEDIAF &amp; AAFCO Reference Tables&#xa;(Protein, Fat, Calcium, Phosphorus, Taurine &amp; Ca:P Ratio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#2E7D5B;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="210" y="485" width="420" height="65" as="geometry" />
        </mxCell>

        <!-- Decision 2: Has Pets -->
        <mxCell id="f7_d2" value="User Has&#xa;Registered Pets?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D4A017;strokeWidth=2;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="335" y="595" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- Decision 3: Allergy Match -->
        <mxCell id="f7_d3" value="Ingredient Matches&#xa;Pet Allergy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D4A017;strokeWidth=2;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="125" y="725" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- Alert Box -->
        <mxCell id="f7_alert" value="Trigger Red Glow Alert&#xa;'[Pet] is allergic to [Item]'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=2;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Safe Box -->
        <mxCell id="f7_safe" value="Mark Safe for Pet&#xa;Include in Smarter Alternatives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#2E7D5B;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="290" y="860" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Final Step: Render -->
